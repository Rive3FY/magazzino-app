# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email (Resend) - per le notifiche di chiusura movimento
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=onboarding@resend.dev

# Push FCM (notifiche Android anche con app in background / chiusa)
# 1) Crea progetto Firebase → aggiungi app Android con package com.magazzino.app2
# 2) Scarica google-services.json in android/app/google-services.json
# 3) Project settings → Service accounts → Generate new private key
# 4) Incolla l'intero JSON su una riga (oppure con \n nella private_key):
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
